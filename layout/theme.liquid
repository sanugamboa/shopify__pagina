
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    {{ page_title }}
  </title>

  {{ content_for_header }}

  <style>
    /* Estilos generales */
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      color: #222;
    }

    /* Encabezado */
    header {
      background-color: #222;
      color: white;
      padding: 20px;
      text-align: center;
    }

    /* Menú de navegación */
    nav {
      background-color: #444;
      padding: 12px;
      text-align: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 10px;
    }

    /* Contenido principal */
    main {
      max-width: 1200px;
      margin: 20px auto;
      padding: 20px;
      background-color: white;
      min-height: 300px;
    }

    /* Pie de página */
    footer {
      background-color: #222;
      color: white;
      text-align: center;
      padding: 15px;
    }
  </style>
</head>

<body>

  <!-- Aquí Shopify carga el contenido de cada página -->
  <main>
    {{ content_for_layout }}
  </main>

</body>
</html>