<section class="hero">
    <div class="hero__imagen">
        {{ section.settings.hero_imagen
            |image_url: width: 500
            |image_tag: alt: shop.name
        }}
    </div>
</section>

{% schema %}
    {
        "name": "hero",
        "settings": [
            {
                "type": "image_picker",
                "id": "hero_imagen",
                "label": "Imagen del Hero"
            }
        ],
        "presets": [
            {
                "name": "hero"
            }
        ]
    }
{% endschema %}